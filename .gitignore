.env
.DS_Store
**/.DS_Store

# Runtime/cache artifacts.
__pycache__/
*.pyc
*.pyo
*.log
*.pid
scripts/**/videos/*.metadata.json
scripts/**/videos/*.metadata_backup_*.json

# Generated or reference media stay local; commit only text metadata/prompts.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tif
*.tiff
*.svg
*.mp4
*.mov
*.m4v
*.avi
*.mkv
*.webm
*.mp3
*.wav
*.m4a
*.aac
*.flac

# Bundled local skills should be complete, including their own reference assets.
!docs/skills/local-creative/**/*.png
!docs/skills/local-creative/**/*.jpg
!docs/skills/local-creative/**/*.jpeg
!docs/skills/local-creative/**/*.webp
!docs/skills/local-creative/**/*.gif
!docs/skills/local-creative/**/*.svg
